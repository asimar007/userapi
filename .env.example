# Server
APP_PORT=8080
LOG_LEVEL=info            # debug | info | warn | error

# Database — either set DATABASE_URL directly...
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/userdb?sslmode=disable

# ...or set the individual parts (used only if DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=userdb
DB_SSLMODE=disable
